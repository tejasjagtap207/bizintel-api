# ========================================
# Copy this to .env and fill in your values
# ========================================

# Database (SQLite works locally, PostgreSQL for Render production)
DATABASE_URL=sqlite:///./bizintel.db

# For Render production, use their PostgreSQL addon:
# DATABASE_URL=postgresql://user:pass@host/dbname

# OpenAI API Key (for LLM-powered chat responses)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# LLM Model (cheapest that works well)
LLM_MODEL=gpt-4o-mini

# Max tokens for AI responses
LLM_MAX_TOKENS=2000

# Port
PORT=8000